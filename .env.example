# ── Database ──────────────────────────────────────────────
POSTGRES_USER=mplads
POSTGRES_PASSWORD=mplads_dev_password
POSTGRES_DB=mplads
# 5434 avoids clashing with any locally installed PostgreSQL on 5432
POSTGRES_PORT=5434
DATABASE_URL=postgresql+psycopg://mplads:mplads_dev_password@localhost:5434/mplads

# ── Backend ───────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-generate-a-real-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=8
CORS_ORIGINS=http://localhost:5173

# ── Frontend (frontend/.env) ──────────────────────────────
# VITE_API_URL=http://localhost:8000
